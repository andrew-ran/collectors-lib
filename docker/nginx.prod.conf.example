# Illustrative production nginx config -- see SELF_HOSTING.md and
# docker-compose.prod.example.yml. Serves the built React SPA (from
# `frontend-build`'s `dist/` output) as static files instead of proxying to
# Vite's dev server, and routes /api, /up, and /storage (admin-uploaded
# covers/photos/gifter avatars, via `php artisan storage:link`) to Laravel,
# same as the dev config (nginx.conf) does for /api and /up.
#
# Not tested end-to-end in this project's sandbox -- verify it serves your
# actual build correctly before relying on it.

server {
    listen 80;
    server_name your-domain.com;
    client_max_body_size 20m;

    # Laravel's public/ dir -- needed for the PHP entry point below and for
    # public/storage (the storage:link symlink target) to resolve.
    location ~ \.php$ {
        root /var/www/html/public;
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ ^/(api|up) {
        root /var/www/html/public;
        try_files $uri /index.php?$query_string;
    }

    # Admin-uploaded covers/photos/avatars -- see docker-compose.prod.example.yml's
    # comment on the storage:link symlink.
    location /storage/ {
        root /var/www/html/public;
        try_files $uri =404;
    }

    # The built React SPA -- everything else.
    location / {
        root /var/www/frontend-dist;
        try_files $uri $uri/ /index.html;
    }
}
