APP_NAME="Collectors Lib"
APP_ENV=testing
# Fixed, non-secret key for CI -- see .github/workflows/ci.yml. Never reuse
# this for a real deployment; generate a fresh one via `php artisan key:generate`.
APP_KEY=base64:SqbTvS7iq6biW7UEWgJ5aTQ2aGcc7Gbnf8CFwXrjr6s=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches the CI workflow's `mysql` service (.github/workflows/ci.yml) --
# root/secret against the collectors_lib_test database it creates.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=collectors_lib_test
DB_USERNAME=root
DB_PASSWORD=secret

# No Redis service defined in CI -- array/sync need nothing external running.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=array

VITE_APP_NAME="${APP_NAME}"

# --- Collectors Lib -------------------------------------------------------

FRONTEND_URL=http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost

# IGDB/Screenscraper -- not exercised by the test suite, left blank.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
SCREENSCRAPER_SOFTNAME=
SCREENSCRAPER_DEVID=
SCREENSCRAPER_DEVPASSWORD=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
