APP_NAME="Collectors Lib"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://collectors-lib.test:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches the `db` service in docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=collectors_lib
DB_USERNAME=collectors_lib
DB_PASSWORD=secret

# See ARCHITECTURE.md -- Redis is used for cache, sessions, and the queue.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Matches the `redis` service in docker-compose.yml.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Collectors Lib -------------------------------------------------------

# React SPA origin. Not currently load-bearing (auth is plain Sanctum API
# tokens, not cookie-based SPA auth -- see ARCHITECTURE.md, Authentication),
# kept here in case a stateful/cookie flow is ever needed.
FRONTEND_URL=http://collectors-lib.test:8090
SANCTUM_STATEFUL_DOMAINS=collectors-lib.test

# IGDB (Twitch Developer app credentials). See docs/API_SOURCES.md and
# docs/tz/NEXT_STEPS.md -- blocked on Twitch 2FA as of 2026-08-11.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Screenscraper (v1 fallback source). See docs/API_SOURCES.md.
SCREENSCRAPER_SOFTNAME=
SCREENSCRAPER_DEVID=
SCREENSCRAPER_DEVPASSWORD=

# Single admin account, seeded by AdminUserSeeder (php artisan db:seed).
# Change ADMIN_PASSWORD before seeding anywhere beyond local dev.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
