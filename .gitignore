# Internal planning docs — not published with the project.
# Public-facing product info lives in README.md instead.
docs/

# Obsidian vault config (local-only workspace state)
.obsidian/

# macOS
.DS_Store

# PHPStorm HTTP Client -- contains real admin credentials for local testing.
requests/http-client.private.env.json

# PHPStorm project settings (local-only; not shared via the repo).
.idea/

# Laravel (src/backend) and React/Vite (src/frontend) each ship their own
# .gitignore, and git respects nested .gitignore files automatically --
# vendor/, node_modules/, .env, etc. are already covered there, no need
# to duplicate them here.

# Docker Compose's own .env at the repo root (DB_PASSWORD/DB_ROOT_PASSWORD
# variable substitution for docker-compose.prod.yml) -- a separate file from
# src/backend/.env, and NOT covered by either nested .gitignore above.
/.env
